# =============================================================================
# SynaptoCore — variables de entorno
# =============================================================================
# Copia este archivo a ".env" y ajusta los valores:
#
#   Windows:      Copy-Item .env.example .env
#   Linux/macOS:  cp .env.example .env
#
# start_brain.bat y start_brain.ps1 cargan .env automáticamente. Si arrancas
# con cargo directamente, exporta las variables antes:
#
#   set -a; source .env; set +a
#   cargo run --release --bin synaptocore
# =============================================================================

# -----------------------------------------------------------------------------
# Modelo de lenguaje (Ollama)
# -----------------------------------------------------------------------------
# URL de Ollama y modelo a usar (descárgalo antes con `ollama pull <modelo>`).
# Si Ollama no responde, el servidor arranca en modo demostración (ServerMock).
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:2b-q4_K_M

# -----------------------------------------------------------------------------
# Más cerebros (opcional)
# -----------------------------------------------------------------------------
# Servidores compatibles con OpenAI donde buscar modelos (LM Studio, Bionic,
# llama.cpp...), separados por comas. Los cerebros se eligen en el panel web
# (botón Cerebros) y la elección se guarda en cerebros.json.
# SYNAPTOCORE_OPENAI_URLS=http://localhost:1234,http://localhost:1235
# SYNAPTOCORE_BRAINS=cerebros.json

# -----------------------------------------------------------------------------
# Buscador web (SearXNG)
# -----------------------------------------------------------------------------
# Permite investigar lo que no está en memoria, verificar lo que se aprende y
# el aprendizaje autónomo. Sin esta variable, lo que no esté en memoria se
# responde como conocimiento general no verificado.
SEARXNG_URL=http://localhost:8888

# -----------------------------------------------------------------------------
# Servidor
# -----------------------------------------------------------------------------
# Puerto de la API y del panel web. El servidor escucha solo en 127.0.0.1.
SYNAPTOCORE_PORT=8080

# -----------------------------------------------------------------------------
# Conectores externos (opcional)
# -----------------------------------------------------------------------------
# Archivo JSON con los sistemas que el asistente puede consultar (ERP, CRM,
# APIs propias...). Plantilla: conectores.example.json
# Por defecto se usa ./conectores.json si existe.
# SYNAPTOCORE_CONNECTORS=conectores.json

# Los secretos de los conectores se definen aquí y se citan en el JSON como ${NOMBRE}.
# ERP_API_TOKEN=tu_token

# -----------------------------------------------------------------------------
# Modelo de embeddings (opcional)
# -----------------------------------------------------------------------------
# Carpeta donde se descarga el modelo multilingüe (~120 MB, solo la primera vez).
# Por defecto: .fastembed_cache en la carpeta de trabajo.
# FASTEMBED_CACHE_DIR=.fastembed_cache

# -----------------------------------------------------------------------------
# CLI `sc`
# -----------------------------------------------------------------------------
# Servidor al que se conecta la CLI (URL completa, con http://).
# SC_HOST=http://127.0.0.1:8080
