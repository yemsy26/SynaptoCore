# =============================================================================
# SynaptoCore — Plantilla de Variables de Entorno
# =============================================================================
# Copia este archivo a ".env" y rellena los valores para tu entorno.
# El script start_brain.ps1 carga automáticamente el .env antes de arrancar.
#
# USO:
#   Copy-Item .env.example .env
#   # Edita .env con tus valores reales
#   .\start_brain.ps1
# =============================================================================

# -----------------------------------------------------------------------------
# MOTOR LLM (elige UNO según tu configuración)
# -----------------------------------------------------------------------------

# [OPCIÓN A — RECOMENDADA] Ollama como backend LLM (gestiona GPU automáticamente)
# URL de la API de Ollama. Por defecto: http://localhost:11434
OLLAMA_HOST=http://localhost:11434
# Modelo a usar (debe estar descargado con `ollama pull <modelo>`).
OLLAMA_MODEL=qwen3.5:2b-q4_K_M

# [OPCIÓN B — Avanzada / RTX directo] LLM local con llama.cpp (GGUF en GPU)
# Ruta absoluta al modelo GGUF descargado (Qwen2.5-7B, Llama-3.2, Mistral, etc.)
# Descarga en: https://huggingface.co/bartowski/Qwen2.5-7B-Instruct-GGUF
# Activa con: cargo run --release --features cuda (RTX) o --features vulkan (AMD/Intel)
# SYNAPTOCORE_MODEL_PATH=C:\Models\qwen2.5-7b-instruct-q4_k_m.gguf

# Número de capas a descargar en la GPU. 999 = todas (máximo rendimiento RTX).
# Reduce este número si tienes poca VRAM (ej. 20 para 6GB de VRAM).
# SYNAPTOCORE_GPU_LAYERS=999

# -----------------------------------------------------------------------------
# BASE DE DATOS DE MEMORIA
# -----------------------------------------------------------------------------

# Ruta al archivo SQLite del grafo de memoria.
# Por defecto (si no se define): "synaptocore_memory.db" en el directorio actual.
SC_DB_PATH=synaptocore_memory.db

# -----------------------------------------------------------------------------
# SERVIDOR API REST
# -----------------------------------------------------------------------------

# Host y puerto donde escucha la API REST de SynaptoCore.
# Cambia a 0.0.0.0:8080 para acceso desde la red local.
SC_HOST=127.0.0.1
SC_PORT=8080

# -----------------------------------------------------------------------------
# BUSCADOR EPISTÉMICO (SearXNG — Verificador de Verdad)
# -----------------------------------------------------------------------------

# URL de tu instancia privada de SearXNG para el módulo TruthFilter.
# Sin esta variable: el motor epistémico opera en modo desconectado (sin búsquedas web).
# Instalación de SearXNG: https://docs.searxng.org/admin/installation.html
# Docker rápido: docker run -p 8888:8080 searxng/searxng
SEARXNG_URL=http://localhost:8888

# -----------------------------------------------------------------------------
# CONECTORES EXTERNOS (Paso 25)
# -----------------------------------------------------------------------------

# Archivo JSON con los sistemas que el cerebro puede consultar (ERP, CRM, APIs
# propias, motores de cálculo...). Plantilla: conectores.example.json
# Sin esta variable se usa ./conectores.json si existe; si no, no hay conectores.
# SYNAPTOCORE_CONNECTORS=conectores.json

# Los secretos de los conectores van aquí y se citan en el JSON como ${NOMBRE}.
# ERP_API_TOKEN=tu_token_secreto_aqui

# -----------------------------------------------------------------------------
# LOGGING Y DIAGNÓSTICO
# -----------------------------------------------------------------------------

# Nivel de logging de Rust (error | warn | info | debug | trace).
# "info" es el nivel recomendado para producción.
RUST_LOG=synaptocore=info,tower_http=warn

# Activa backtrace en panics (útil para depuración, desactiva en producción).
# RUST_BACKTRACE=1
